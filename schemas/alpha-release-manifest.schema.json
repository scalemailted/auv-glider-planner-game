{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anchor.local/schemas/alpha-release-manifest.schema.json",
  "schemaVersion": "1.0.0",
  "describes": "anchor.alpha-release-manifest",
  "type": "object",
  "required": [
    "artifactType",
    "artifactVersion",
    "releaseId",
    "releaseVersion",
    "releaseChannel",
    "applicationCommit",
    "defaultRuntimeShell",
    "packageVersions",
    "validationBaseline",
    "classicalPlannerNotebook",
    "scoring",
    "acceptance",
    "knownLimitations",
    "claimBoundary",
    "releaseDigest"
  ],
  "properties": {
    "artifactType": { "const": "anchor.alpha-release-manifest" },
    "artifactVersion": { "const": "1.0.0" },
    "releaseId": { "type": "string" },
    "releaseVersion": { "type": "string" },
    "releaseChannel": { "const": "alpha" },
    "applicationCommit": { "type": "string" },
    "defaultRuntimeShell": { "type": "string" },
    "packageVersions": { "type": "object" },
    "validationBaseline": {
      "type": "object",
      "required": ["id", "digest", "reportCount", "statusSummary", "evidenceLevelSummary"]
    },
    "classicalPlannerNotebook": {
      "type": "object",
      "required": ["localPythonExecutionVerified", "localAcceptanceDigest", "googleColabHostingSmoke"]
    },
    "scoring": {
      "type": "object",
      "required": ["profileId", "profileVersion", "profileDigest"]
    },
    "acceptance": {
      "type": "object",
      "required": [
        "phase",
        "ownerReviewStatus",
        "browserSupportMatrix",
        "notebookVerification",
        "scenarioCatalog",
        "criticalPathAcceptance",
        "knownP0P1Issues",
        "releaseRecommendation"
      ],
      "properties": {
        "phase": { "const": "ALPHA-R1.1" },
        "ownerReviewStatus": { "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "browserSupportMatrix": { "type": "array" },
        "notebookVerification": {
          "type": "object",
          "required": [
            "localPythonExecution",
            "authoritativeAnchorFinalization",
            "pagesNotebookDelivery",
            "googleColabHostingSmoke"
          ]
        },
        "knownP0P1Issues": { "type": "array" },
        "releaseRecommendation": {
          "enum": [
            "ALPHA_R1_ACCEPTANCE_PACKAGE_READY",
            "ALPHA_R1_LIMITED_PILOT_READY",
            "ALPHA_R1_EXTERNAL_PILOT_READY",
            "NO_GO_FOR_ALPHA_PILOT"
          ]
        }
      }
    },
    "knownLimitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "claimBoundary": { "type": "string" },
    "releaseDigest": { "type": "string" }
  }
}
