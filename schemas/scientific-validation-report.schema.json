{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/scientific-validation-report.schema.json",
  "title": "ANCHOR Scientific Validation Report",
  "describes": "anchor.scientific-validation-report",
  "schemaVersion": "1.0",
  "type": "object",
  "required": ["schemaVersion", "type", "reportId", "componentId", "componentLabel", "modelId", "modelVersion", "claims", "evidence", "claimBoundary", "reportDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "type": { "const": "anchor.scientific-validation-report" },
    "reportId": { "type": "string" },
    "componentId": { "type": "string" },
    "componentLabel": { "type": "string" },
    "modelId": { "type": "string" },
    "modelVersion": { "type": "string" },
    "summary": { "type": "string" },
    "claims": { "type": "array", "items": { "type": "object" } },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "evidenceLevelSummary": { "type": "object" },
    "statusSummary": { "type": "object" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "references": { "type": "array", "items": { "type": "object" } },
    "packageVersions": { "type": "object" },
    "sourceArtifactDigests": { "type": "object" },
    "suitabilityDecision": { "type": "object" },
    "visualizations": { "type": "array" },
    "claimBoundary": {
      "type": "object",
      "required": ["benchmarkOrEducationUse", "operationalForecast", "certifiedNavigation", "calibratedDigitalTwin"]
    },
    "visibilityClass": { "type": "string" },
    "fairnessClass": { "type": "string" },
    "reportDigest": { "type": "string" }
  }
}